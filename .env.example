# ============================================================
# 环境变量模板 —— 复制为 .env 使用（.env 永不入库）
# 本文件是文档：每台机器/环境各自维护真实值
# 变量清单依据：deployment-design.md §8（8 个，fail-fast：缺任一启动即失败）
# ============================================================

# Django 密钥：强随机值。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-生成后替换

# 调试开关：本地开发 True；test/prod 恒 False（有测试断言）
DEBUG=True

# 站点绝对地址（canonical/sitemap/分享卡片的唯一来源）：
#   本地=http://127.0.0.1:8000；阶段 A=http://<ECS-IP>；阶段 B=https://域名
SITE_URL=http://127.0.0.1:8000

# 允许的 Host：本地开发用默认值；生产按 deployment-design §7 配置
ALLOWED_HOSTS=localhost,127.0.0.1

# 会话 Cookie Secure 标志：阶段 A（HTTP）=False；阶段 B（HTTPS）=True（SEC-1）
COOKIE_SECURE=False

# 备份目录：/healthz 检查备份文件新鲜度用（本地开发可指向任意空目录）
BACKUP_DIR=./backups

# /healthz 磁盘余量告警阈值（百分比；实现与单位以 T-015 为准）
HEALTHZ_DISK_THRESHOLD=10

# /healthz 备份新鲜度上限（小时；超过即 503；实现以 T-015 为准）
HEALTHZ_BACKUP_MAX_AGE=48
